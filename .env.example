PORT=4173
BACKEND_URL=http://127.0.0.1:4180
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Express/PostgreSQL backend
BACKEND_PORT=4180
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zetgaming
DATABASE_SSL=false
SEED_DEMO=false
FRONTEND_ORIGIN=http://localhost:4173
RESET_DELIVERY=disabled
LOCAL_PG_PASSWORD=postgres
LOCAL_PG_DATABASE=zetgaming

# OAuth providers (leave empty until credentials/callback URLs are supplied)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4180/api/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4180/api/auth/oauth/facebook/callback
